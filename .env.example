# — only override what you need to change.

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=rag_chatbot

EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIM=768

LLM_MODEL_NAME=mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

CHUNK_SIZE=512
CHUNK_OVERLAP=64

API_PORT=8000
